<CPackWiXPatch>
  <!-- Inject the Windows Service installation into the component generated for valkey-service.exe -->
  <CPackWiXFragment Id="CM_CP_bin.valkey_service.exe">
    <ServiceInstall Id="ServiceInstaller"
                    Type="ownProcess"
                    Name="Valkey"
                    DisplayName="Valkey Server"
                    Description="Valkey high-performance key/value datastore."
                    Start="auto"
                    Account="LocalSystem"
                    ErrorControl="normal" />
    <ServiceControl Id="StartService" Start="install" Stop="both" Remove="uninstall" Name="Valkey" Wait="yes" />
  </CPackWiXFragment>
</CPackWiXPatch>
